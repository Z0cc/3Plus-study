    "tags": ["诗经", "古诗", "爱情诗"],
    "lines": [
      { "text": "静女其姝，", "pinyin": "jìng nǚ qí shū" },
      { "text": "俟我于城隅。", "pinyin": "sì wǒ yú chéng yú" },
      { "text": "爱而不见，", "pinyin": "ài ér bù jiàn" },
      { "text": "搔首踟蹰。", "pinyin": "sāo shǒu chí chú" },
      { "text": "静女其娈，", "pinyin": "jìng nǚ qí luán" },
      { "text": "贻我彤管。", "pinyin": "yí wǒ tóng guǎn" },
      { "text": "彤管有炜，", "pinyin": "tóng guǎn yǒu wěi" },
      { "text": "说怿女美。", "pinyin": "yuè yì rǔ měi" },
      { "text": "自牧归荑，", "pinyin": "zì mù kuì tí" },
      { "text": "洵美且异。", "pinyin": "xún měi qiě yì" },
      { "text": "匪女之为美，", "pinyin": "fēi rǔ zhī wéi měi" },
      { "text": "美人之贻。", "pinyin": "měi rén zhī yí" }
    ],
